{
  "name": "voti-free-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "RELAY_ID": "voti-free-test",
    "REMOTE_ASSETS_ENABLED": "false",
    "ALLOWED_ORIGINS": "http://127.0.0.1:4173",
    "TURNSTILE_MODE": "local-test",
    "PREPARATION_TTL_SECONDS": "86400"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "voti-free-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations", "remote": false
  }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "33001", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATION_LIMITER", "namespace_id": "33002", "simple": { "limit": 30, "period": 60 } },
    { "name": "ASSET_LIMITER", "namespace_id": "33003", "simple": { "limit": 600, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
