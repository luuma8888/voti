{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voti-relay",
  "account_id": "1c74451e938197bbcd316939932fc778",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "RELAY_ID": "voti-production",
    "REMOTE_ASSETS_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://luuma8888.github.io",
    "PREPARATION_TTL_SECONDS": "86400",
    "TURNSTILE_MODE": "siteverify",
    "TURNSTILE_HOSTNAMES": "luuma8888.github.io"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "voti-production",
    "database_id": "bb3329c1-7de3-4147-8d07-af8679b6cd12",
    "migrations_dir": "migrations", "remote": false
  }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "34001", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATION_LIMITER", "namespace_id": "34002", "simple": { "limit": 30, "period": 60 } },
    { "name": "ASSET_LIMITER", "namespace_id": "34003", "simple": { "limit": 600, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
