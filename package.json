{
  "name": "voti",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build-production.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-reporter=dot tests/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:pwa": "node --test tests/pwa.test.js && node scripts/browser-pwa.mjs",
    "check": "node scripts/check.mjs",
    "worker:local": "node scripts/relay-local.mjs dev",
    "worker:migrate": "node scripts/relay-local.mjs migrate",
    "worker:cleanup": "node scripts/relay-local.mjs cleanup",
    "test:relay": "node scripts/relay-integration.mjs",
    "test:integration": "node scripts/relay-integration.mjs --browser",
    "test:free-pilot": "node scripts/free-pilot-integration.mjs --browser",
    "test:poster": "node scripts/test-posters.mjs",
    "test:poster-studio": "node scripts/test-posters.mjs --studio",
    "test:poster-polish": "node scripts/test-posters.mjs --polish",
    "test:poster-images": "node scripts/test-posters.mjs --images",
    "test:participation": "node scripts/browser-test.mjs --participation",
    "test:comments": "node scripts/test-posters.mjs --participation",
    "test:spaces": "node scripts/free-pilot-integration.mjs --spaces --spaces-browser",
    "test:space-ui": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser --space-layout",
    "test:spaces-ux": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser",
    "test:member-scanner": "node scripts/browser-test.mjs --member-scanner",
    "test:member-cards": "node scripts/test-member-cards.mjs",
    "test:visual-api": "node scripts/free-pilot-integration.mjs --spaces-browser-only --visual-identities",
    "test:visual-identities": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser --visual-identities",
    "test:visual-pdf": "node scripts/test-visual-cards.mjs",
    "test:card-background-batch": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser --card-background-batch",
    "test:card-background-pdf": "node scripts/test-card-background-pdf.mjs",
    "test:card-ux": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser --card-ux",
    "test:card-ux-pdf": "node scripts/test-card-ux-pdfs.mjs",
    "test:card-polish": "node scripts/test-card-polish.mjs",
    "test:spaces-migration": "node scripts/spaces-migration-checks.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "test:groups-hd-v2": "node scripts/free-pilot-integration.mjs --spaces-browser-only --spaces-browser --groups-hd-v2",
    "test:groups-hd-v2-pdf": "node scripts/test-card-background-pdf.mjs .browser-tests/voti-groups-hd-v2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "node": "22.23.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4"
  }
}
