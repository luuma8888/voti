    "worker:cleanup": "node scripts/relay-local.mjs cleanup",
    "test:relay": "node scripts/relay-integration.mjs",
    "test:integration": "node scripts/relay-integration.mjs --browser",
    "test:free-pilot": "node scripts/free-pilot-integration.mjs --browser",
    "audit:bundle": "node scripts/audit-bundle.mjs"
  },
  "devDependencies": {
    "node": "22.23.3",
    "wrangler": "4.149.0"
  }
